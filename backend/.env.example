# Local development template — copy to backend/.env and fill in.
# Placeholders only: never put a real secret in this file.

PORT=4000
NODE_ENV=development

# MySQL connection for the app, and a separate database for the test suite.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/onsidehr"
TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/onsidehr_test"

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET=change_me

# Application-level column encryption for Employee niNumber, passportNumber,
# accountNumber and sortCode (AES-256-GCM). 32 bytes of hex.
#   openssl rand -hex 32
# The API refuses to start without it: booting without a key would write those
# columns to disk in plaintext. One key per environment; losing it loses the
# data (it is not in the database dump). Backfill legacy plaintext rows with
#   npm --prefix backend run encrypt:fields
FIELD_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173

# Email (Nodemailer SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=OnsideHR

# Document storage: local | r2
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Google Calendar integration (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Seed-only bootstrap accounts (npm run seed / npm run bootstrap:users)
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_MANAGER_EMAIL=
# BOOTSTRAP_MANAGER_PASSWORD=
# BOOTSTRAP_MANAGER_NAME=
