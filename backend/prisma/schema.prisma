generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id           Int       @id @default(autoincrement())
  slug         String    @unique // "acme-ltd" — used in exports and R2 keys
  name         String // "Acme Ltd" — display name
  status       String    @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | CANCELLED
  plan         String    @default("CORE") // CORE | CORE_PLUS_COMPLIANCE
  seatLimit    Int? // null = unlimited
  features     Json? // { "compliance": true }
  logoUrl      String?
  primaryColor String?   @default("#1d4f66")
  trialEndsAt  DateTime?
  deletedAt    DateTime? // soft delete → retention window before hard delete
  createdAt    DateTime  @default(now())

  settings           TenantSettings?
  users              User[]
  employees          Employee[]
  sponsorships       Sponsorship[]
  complianceEvidence SponsorshipComplianceEvidence[]
  reportableEvents   SponsorshipReportableEvent[]
  absenceRecords     AbsenceRecord[]
  payRecords         PayRecord[]
  projects           Project[]
  timesheets         Timesheet[]
  leaveRequests      LeaveRequest[]
  documents          Document[]
  auditLogs          AuditLog[]
  dataConsents       DataConsent[]
  rightToWorkChecks  RightToWorkCheck[]
  sponsorLicence     SponsorLicence?
  notifications      Notification[]
}

model TenantSettings {
  id                Int     @id @default(autoincrement())
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          Int     @unique
  leaveYearStart    String  @default("01-01") // MM-DD
  defaultLeaveDays  Float   @default(28) // UK statutory minimum incl. bank holidays
  bankHolidayRegion String  @default("england-and-wales") // | scotland | northern-ireland
  workingDays       String  @default("1,2,3,4,5") // ISO weekday numbers
  companyAddress    String?
}

// Sponsor licence details (one per tenant). Separate from TenantSettings so
// calendar/leave config and Home Office compliance state do not share a row.
// Level 1/2 user lists mirror the SMS user list — names and emails only.
model SponsorLicence {
  id                      Int       @id @default(autoincrement())
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                Int       @unique
  licenceNumber           String?
  rating                  String    @default("A") // A | B
  expiryDate              DateTime?
  authorisingOfficer      String?
  authorisingOfficerEmail String?
  keyContact              String?
  keyContactEmail         String?
  level1Users             Json? // [{ name, email }]
  level2Users             Json?
  cosDefinedAllocated     Int       @default(0)
  cosUndefinedAllocated   Int       @default(0)
  allocationYearStart     DateTime? // start of the current CoS allocation year
  // A B-rating comes with a time-limited action plan; missing its deadline
  // means licence revocation, so the dates are first-class and alerted on.
  actionPlanIssuedAt      DateTime?
  actionPlanDueAt         DateTime?
  actionPlanNotes         String?   @db.Text
  updatedAt               DateTime  @updatedAt
}

// Platform operators (us) — deliberately a separate table, not a tenant role,
// so no tenant-side bug can ever escalate into cross-tenant access.
model PlatformAdmin {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  name       String?
  totpSecret String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Tenant-scoped models
// ---------------------------------------------------------------------------

model User {
  id            Int            @id @default(autoincrement())
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      Int
  email         String         @unique // global: email is the tenant resolver at login
  password      String
  name          String?
  role          String         @default("USER")
  tokenVersion  Int            @default(0) // bumped to revoke outstanding JWTs
  totpSecret    String? // pending or active TOTP secret (2FA)
  totpEnabled   Boolean        @default(false)
  employeeId    Int?           @unique
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  createdAt     DateTime       @default(now())
  googleAccount GoogleAccount?
  notifications Notification[]

  @@index([tenantId])
}

model Employee {
  id               Int       @id @default(autoincrement())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         Int
  firstName        String
  middleName       String?
  lastName         String
  title            String? // Mr, Mrs, Dr, etc.
  gender           String?
  ethnicity        String?
  dateOfBirth      DateTime?
  email            String
  phoneNumber      String?
  workPhone        String?
  // Encrypted at rest (AES-256-GCM) by the prismaClient extension — see
  // src/lib/fieldEncryption.ts. TEXT because the stored value is base64 of
  // IV + auth tag + ciphertext, and unfilterable because every row has its own IV.
  niNumber         String?   @db.Text // National Insurance
  jobTitle         String?
  employeeType     String    @default("EMPLOYEE") // EMPLOYEE or DIRECTOR
  department       String?
  startDate        DateTime?
  endDate          DateTime?
  probationEndDate DateTime?

  // Address Details
  address1 String?
  address2 String?
  address3 String?
  townCity String?
  county   String?
  postcode String?

  // Bank Details
  accountName   String?
  bankName      String?
  bankBranch    String?
  accountNumber String? @db.Text // encrypted at rest
  sortCode      String? @db.Text // encrypted at rest

  // Salary Details
  salary              Float?
  salaryRate          String?
  paymentFrequency    String?
  salaryEffectiveFrom DateTime?
  salaryReason        String?
  payrollNumber       String?

  // Sensitive Identity and Eligibility Details
  taxCode                String?
  passportNumber         String?   @db.Text // encrypted at rest
  passportCountryOfIssue String?
  passportExpiryDate     DateTime?
  licenceNumber          String?
  licenceCountryOfIssue  String?
  licenceClass           String?
  licenceExpiryDate      DateTime?
  visaNumber             String?
  visaExpiryDate         DateTime?

  // DBS (Disclosure and Barring Service) — for roles that require one.
  dbsLevel             String? // BASIC | STANDARD | ENHANCED | ENHANCED_BARRED
  dbsCertificateNumber String?   @db.Text // encrypted at rest
  dbsIssueDate         DateTime?
  dbsRecheckDate       DateTime?

  // Data retention. retainUntil is set when employment ends (see
  // lib/retention.ts); the nightly sweep anonymises the row once it passes.
  retainUntil  DateTime?
  anonymisedAt DateTime?

  // Emergency Contact Information
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  emergencyContactAddress  String?

  user              User?
  sponsorships      Sponsorship[]
  documents         Document[]
  timesheets        Timesheet[]
  leaveRequests     LeaveRequest[]
  absences          AbsenceRecord[]
  payRecords        PayRecord[]
  rightToWorkChecks RightToWorkCheck[]

  @@unique([tenantId, email])
}

// Every right-to-work check ever performed, not just the latest: the statutory
// excuse depends on being able to show the check that was done at the time.
// The most recent row per employee drives recheck reminders.
model RightToWorkCheck {
  id          Int       @id @default(autoincrement())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  Int
  checkDate   DateTime
  method      String // MANUAL | IDVT | HOME_OFFICE_ONLINE
  shareCode   String?   @db.Text // encrypted at rest
  outcome     String    @default("PASS") // PASS | FAIL
  timeLimited Boolean   @default(false)
  recheckDue  DateTime?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId  Int?
  checkedBy   Int? // User id
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([tenantId, employeeId, checkDate])
}

model Sponsorship {
  id                   Int                             @id @default(autoincrement())
  tenant               Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId             Int
  employee             Employee                        @relation(fields: [employeeId], references: [id])
  employeeId           Int
  visaType             String
  casNumber            String? // Confirmation of acceptance for studies or CAS if relevant
  sponsorLicenseNumber String?
  // Certificate of Sponsorship terms, reconciled against actual pay each period.
  socCode              String?
  jobTitleOnCos        String?
  cosSalary            Float? // annual gross stated on the CoS
  cosWeeklyHours       Float?
  // Going rate for the SOC code. Recorded per sponsorship rather than derived
  // from a vendored rate table, which moves with every guidance revision.
  goingRateSalary      Float?
  workLocation         String?
  // Certificate of Sponsorship lifecycle: defined (overseas) or undefined
  // (in-country) allocation, when it was assigned, and the date the worker
  // must have started by (a CoS lapses three months after assignment).
  cosType              String? // DEFINED | UNDEFINED
  cosAssignedDate      DateTime?
  cosStartBy           DateTime?
  iscAmount            Float? // Immigration Skills Charge paid
  startDate            DateTime
  endDate              DateTime?
  complianceNotes      String?
  active               Boolean                         @default(true)
  complianceEvidence   SponsorshipComplianceEvidence[]
  reportableEvents     SponsorshipReportableEvent[]

  @@index([tenantId])
}

model SponsorshipComplianceEvidence {
  id            Int         @id @default(autoincrement())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      Int
  sponsorship   Sponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  sponsorshipId Int
  document      Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId    Int?
  evidenceType  String
  notes         String?     @db.Text
  verifiedAt    DateTime?
  verifiedBy    Int?
  createdAt     DateTime    @default(now())

  @@index([tenantId])
}

model SponsorshipReportableEvent {
  id            Int         @id @default(autoincrement())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      Int
  sponsorship   Sponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  sponsorshipId Int
  eventType     String
  eventDate     DateTime
  dueDate       DateTime
  status        String      @default("OPEN")
  notes         String?     @db.Text
  reportedAt    DateTime?
  reportedBy    Int?
  createdAt     DateTime    @default(now())

  @@index([tenantId])
}

model Project {
  id          Int         @id @default(autoincrement())
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Int
  code        String
  name        String
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  timesheets  Timesheet[]

  @@unique([tenantId, code])
}

model Timesheet {
  id         Int      @id @default(autoincrement())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int
  project    Project? @relation(fields: [projectId], references: [id])
  projectId  Int?
  date       DateTime
  hours      Float
  notes      String?

  @@index([tenantId])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int
  type       String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PENDING")
  reason     String?

  @@index([tenantId])
}

// One row per employee per calendar day, only for days that are not plain
// attendance. UNAUTHORISED days on a sponsored worker are what drive the
// 10-working-day Home Office report (sponsor guidance Part 3 C1.15).
model AbsenceRecord {
  id         Int      @id @default(autoincrement())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId Int
  date       DateTime
  status     String // AUTHORISED | UNAUTHORISED | SICK | UNKNOWN
  source     String // LEAVE_REQUEST | TIMESHEET_GAP | MANUAL
  notes      String?
  recordedBy Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, employeeId, date])
  @@index([tenantId, status])
}

// Actual pay per period, imported from payroll. From 8 April 2026 salary
// compliance is assessed per pay period rather than annually, so this is the
// evidence the reconciliation runs against.
model PayRecord {
  id          Int      @id @default(autoincrement())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  Int
  periodStart DateTime
  periodEnd   DateTime
  grossPay    Float
  hoursWorked Float?
  source      String // CSV_IMPORT | MANUAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, employeeId, periodStart])
  @@index([tenantId, employeeId, periodStart])
}

model Document {
  id                            Int                             @id @default(autoincrement())
  tenant                        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                      Int
  employee                      Employee                        @relation(fields: [employeeId], references: [id])
  employeeId                    Int
  name                          String
  path                          String
  type                          String? // Document type (e.g., CONTRACT, PASSPORT, etc.)
  expiryDate                    DateTime? // Optional expiry date for documents
  uploadedAt                    DateTime                        @default(now())
  sponsorshipComplianceEvidence SponsorshipComplianceEvidence[]
  rightToWorkChecks             RightToWorkCheck[]

  @@index([tenantId])
}

model GoogleAccount {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id])
  userId       Int       @unique
  refreshToken String
  accessToken  String?
  scope        String?
  expiry       DateTime?
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  // Nullable: platform-level events (failed logins for unknown emails,
  // platform-admin actions) have no tenant. Tenant reads filter by exact
  // tenantId, so platform rows never leak into a tenant's audit view.
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int?
  userId    Int?
  userEmail String?
  action    String // CREATE, READ, UPDATE, DELETE, LOGIN, EXPORT, etc.
  entity    String // Employee, Document, User, etc.
  entityId  Int?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([tenantId])
}

model DataConsent {
  id            Int       @id @default(autoincrement())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      Int
  employeeId    Int
  consentType   String // GDPR_PROCESSING, PRIVACY_NOTICE, etc.
  consentGiven  Boolean   @default(false)
  consentDate   DateTime?
  withdrawnDate DateTime?
  ipAddress     String?
  version       String? // Version of privacy policy
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

// In-app inbox. Written by lib/notify.ts alongside (not instead of) email so
// a user who ignores email still sees the leave decision, expiry or approval
// request in the bell. Rows are per user; the tenant column keeps the sweep
// and the inbox query scoped.
model Notification {
  id        Int       @id @default(autoincrement())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      String // LEAVE_REQUEST, LEAVE_DECISION, EXPIRY, ...
  title     String
  body      String?   @db.Text
  link      String? // in-app path, e.g. /leave
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
}
